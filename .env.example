# Copy to .env for local development. Production values live in .env.production
# and are baked into the bundle by `npm run build`.

# CMS API base URL (including /api)
VITE_API_BASE_URL=http://localhost:4000/api

# Public blog, used for "View on blog" links and SEO previews
VITE_BLOG_SITE_URL=http://localhost:8081
